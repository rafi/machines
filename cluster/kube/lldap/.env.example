# LLDAP environment variables
# https://github.com/lldap/lldap?tab=readme-ov-file#with-docker

# shellcheck disable=SC2034,SC2125,SC2209

LLDAP_VERBOSE=false

LLDAP_HTTP_URL=https://ldap.foo.io
LLDAP_LDAP_BASE_DN=dc=foo,dc=io

LLDAP_BOOTSTRAP_DO_CLEANUP=false

LLDAP_LDAP_USER_DN=admin
LLDAP_LDAP_USER_PASS=
LLDAP_LDAP_USER_EMAIL=

LLDAP_JWT_SECRET=
LLDAP_KEY_SEED=

LLDAP_DATABASE_URL=sqlite:///data/users.db?mode=rwc
LLDAP_SMTP_PASSWORD=
