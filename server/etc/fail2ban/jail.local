# FAIL2BAN
# ---
# See man 5 jail.conf for details.
# See jail.conf(5) man page for more information
#
# What differs from the package's jail.conf and jail.d/defaults-debian.conf;
# every other setting, and the sshd jail's log backend, comes from those.
# Upstream defaults: https://github.com/fail2ban/fail2ban/blob/master/config/jail.conf

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime = 60m

[sshd]
enabled = true
