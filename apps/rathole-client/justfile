# RAFI RATHOLE-CLIENT

APP_NAME := "rathole-client"

import '../../lib/util.just'

_default: list

generate-secrets:
	secretspec get RATHOLE_ROOT_CA_CRT > tls/rootCA.crt
	secretspec run --scope rathole-client -- \
		envsubst < files/client.example.toml > files/client.toml

clean-secrets:
	rm -f files/client.toml tls/rootCA.crt

# Deploy rathole-client to a Kubernetes cluster.
kube: generate-secrets && clean-secrets
	kubectl apply -k .

# Run rathole-client locally with docker compose.
# compose:
# 	docker compose up

# Install rathole-client on a remote host as systemd service via SSH.
# ssh-binary host: (sync-files host 'tls/rootCA.crt') (with-binary host)

# Install rathole-client on a remote host with package-manager via SSH.
# ssh-package host: (sync-files host 'tls/rootCA.crt') (with-package-manager host)
