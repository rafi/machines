# RAFI RATHOLE-CLIENT

import '../../lib/util.just'

_default: list

# Deploy rathole-client to a Kubernetes cluster.
kube:
	kubectl apply -k .

# Run rathole-client locally with docker compose.
# compose:
# 	docker compose up

# Install rathole-client on a remote host as systemd service via SSH.
systemd host: (_sync host) (installer host)

# Install authelia on a remote host with package-manager via SSH.
# pkg host: (_sync host) (installer-pkg host)

_sync host: (rsync host '/var/local/rathole' 'tls/rootCA.crt')
