# 'server' block

listen unix:/run/nginx-ingress.sock ssl http2 proxy_protocol;

ssl_certificate /etc/letsencrypt/live/${SECRET_DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${SECRET_DOMAIN}/privkey.pem;

include /etc/nginx/snippets/ssl.nginx;
include /etc/nginx/snippets/authelia-location.nginx;

set $upstream http://127.0.0.1:32000;

location / {
	include /etc/nginx/snippets/proxy.nginx;
	include /etc/nginx/snippets/authelia-authrequest.nginx;
	proxy_pass $upstream;
}
