# Port 443 carries SSH and TLS. Every connection gets a PROXY protocol header
# with the client's address, so whoever ends it knows who connected:
# - not TLS (SSH): through ssh-strip below, which drops the header, to
#   rathole's ssh service;
# - TLS: encrypted and untouched to rathole's ingress-tls service and
#   Traefik's websecure port, which terminates it. A host listed as `web`
#   in the map below would go to nginx's http sites instead; none is left.
stream {
	upstream ssh {
		server unix:/run/nginx-ssh.sock;
	}

	upstream web {
		server unix:/run/nginx-ingress.sock;
	}

	upstream cluster {
		server 127.0.0.1:32443;
	}

	# TLS ends in the cluster for every host.
	map $ssl_preread_server_name $tls_upstream {
		hostnames;
		default cluster;
	}

	map $ssl_preread_protocol $upstream {
		"" ssh;
		default $tls_upstream;
	}

	server {
		listen 443;

		# Max time to connect to server
		proxy_connect_timeout 10s;
		# Max time between successive reads or writes
		proxy_timeout 5m;

		ssl_preread on;
		proxy_protocol on;
		proxy_pass $upstream;
	}

	# ssh-strip: sshd doesn't speak the PROXY protocol.
	server {
		listen unix:/run/nginx-ssh.sock proxy_protocol;
		proxy_connect_timeout 10s;
		proxy_timeout 5m;
		proxy_pass 127.0.0.1:32022;
	}
}

# vim: set ft=nginx ts=2 sw=2 tw=80 noet :
