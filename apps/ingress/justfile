# RAFI INGRESS

APP_NAME := "ingress"

import '../../lib/util.just'

_default: list

# Deploy ingress to a Kubernetes cluster.
kube:
	kubectl apply -k .

# Run ingress locally with docker compose.
compose:
	docker compose up

# Install ingress on a remote host as systemd service via SSH.
# ssh-binary host: (sync-files host) (with-binary host)

# Install ingress on a remote host with package-manager via SSH.
[no-cd]
ssh-package host: (sync-files host) (with-package-manager host)
