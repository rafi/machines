[Unit]
Description=LLDAP
Documentation=https://github.com/lldap/lldap
After=network.target

[Service]
Type=simple
User=lldap
Group=lldap
ExecStart=/opt/lldap/lldap run --config-file /etc/lldap/config.toml
Restart=on-failure
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
WorkingDirectory=/var/lib/lldap
ReadWriteDirectories=/var/lib/lldap

[Install]
WantedBy=multi-user.target

