[Unit]
Description=Nitnelave LLDAP
Documentation=https://github.com/nitnelave/lldap
After=network.target

[Service]
Type=simple
User=lldap
Group=lldap
ExecStart=/usr/bin/lldap run --config-file /etc/lldap/config.toml
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
WorkingDirectory=/etc/lldap
ReadWriteDirectories=/var/lib/lldap

[Install]
WantedBy=multi-user.target

