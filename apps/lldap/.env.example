# LLDAP environment variables
# https://github.com/lldap/lldap?tab=readme-ov-file#with-docker

# shellcheck disable=SC2034,SC2125,SC2209

LLDAP_VERBOSE=false

LLDAP_URL=http://lldap-http:12234
LLDAP_HTTP_PORT=12234
LLDAP_HTTP_URL=https://ldap.example.com
LLDAP_LDAP_BASE_DN=dc=example,dc=com

DO_CLEANUP=false

LLDAP_ADMIN_USERNAME=admin
LLDAP_ADMIN_PASSWORD=
LLDAP_LDAP_USER_EMAIL=

LLDAP_JWT_SECRET=
LLDAP_KEY_SEED=

LLDAP_DATABASE_URL=sqlite:///data/users.db?mode=rwc
LLDAP_SMTP_PASSWORD=
