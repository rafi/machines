# RAFI RATHOLE-SERVER

APP_NAME := "rathole-server"

import '../../lib/util.just'

_default: list

generate-secrets:
	secretspec get RATHOLE_IDENTITY_PFX > tls/identity.pfx
	secretspec run --scope rathole-server -- \
		envsubst < files/server.example.toml > files/server.toml

clean-secrets:
	rm -f files/server.toml tls/identity.pfx

# Deploy rathole-server to a Kubernetes cluster.
kube:
	kubectl apply -k .

# Run rathole-server locally with docker compose.
compose:
	docker compose up

# Install rathole-server on a remote host as systemd service via SSH.
ssh-binary host: (sync-files host 'tls/identity.pfx') (with-binary host)

# Install rathole-server on a remote host with package-manager via SSH.
[no-cd]
ssh-package host: (sync-files host 'tls/identity.pfx') (with-package-manager host)
