# Miniflux: keys of Secret `miniflux-env`, kept in the consuming repo (sops).
# https://miniflux.app/docs/configuration.html

ADMIN_PASSWORD=
ADMIN_USERNAME=admin
CREATE_ADMIN=1
RUN_MIGRATIONS=1

MINIFLUX_HOST_NAME=foo.bar.io
BASE_URL=https://foo.bar.io/miniflux

# Password must match Secret pg-miniflux in the db namespace.
DATABASE_URL=postgres://usrminiflux:password@postgres-rw.db.svc.cluster.local/miniflux?sslmode=disable
