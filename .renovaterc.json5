{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Managers for Flux (HelmRelease, OCIRepository, GitRepository), images in
  // HelmRelease values, GitHub Actions pinned to digests, commit messages.
  extends: ["github>home-operations/renovate-presets#8.1.0"],
  // The cluster and CI only: the server's versions are pinned in its
  // installers.
  ignorePaths: ["server/**"],
  packageRules: [
    {
      description: "The Flux Operator and its FluxInstance chart ship together",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator$/", "/flux-instance$/"],
    },
    {
      description: "pg_dump in the backup job follows the cluster's Postgres 16",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      allowedVersions: "/^16\\./",
    },
    // Labels by update type (defined in .github/labels.yaml)
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
