{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Managers for Flux (HelmRelease, OCIRepository, GitRepository), images in
  // HelmRelease values, GitHub Actions pinned to digests, commit messages.
  extends: ["github>home-operations/renovate-presets#8.1.0"],
  // The cluster and CI only. apps/ is the systemd/kube/compose playground and
  // the server's versions are pinned in its installers.
  ignorePaths: ["apps/**", "server/**"],
  packageRules: [
    {
      description: "Flux updates as a whole (flux manager regenerates gotk-components), not one controller image at a time",
      matchManagers: ["kubernetes"],
      matchFileNames: ["kubernetes/flux/flux-system/gotk-components.yaml"],
      enabled: false,
    },
  ],
}
